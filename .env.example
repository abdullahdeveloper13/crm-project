# NovaCRM AI - Environment Variables Configuration

# -----------------------------------------------------------------------------
# SUPABASE BACKEND CONFIGURATION (Server-side runtime)
# -----------------------------------------------------------------------------
# Required: The base URL of your Supabase project instance
SUPABASE_URL="https://your-project-id.supabase.co"

# Required: The anon / publishable API key for client & SSR queries
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"

# Optional/Admin: The service role secret key. NEVER expose to the browser bundle.
# Used exclusively inside *.server.ts modules and trusted administrative tasks.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_your_service_role_key_here"

# -----------------------------------------------------------------------------
# VITE FRONTEND CONFIGURATION (Client-side bundle)
# -----------------------------------------------------------------------------
# Required: The base URL of your Supabase project instance
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Required: The publishable API key accessible in the browser
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"

# Optional: Supabase Project ID identifier
VITE_SUPABASE_PROJECT_ID="your-project-id"
